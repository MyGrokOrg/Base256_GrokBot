# Default-path identity on any platform: run mode_digest (EXE, ARGS) and compare
# its digests with the Linux golden file (GOLDEN, produced by g++-14 on x86-64).
# Every key must match, except to_long_double, which depends on the long double
# format: an x87 80-bit long double must match the golden digest; a binary64
# long double ("to_long_double_b64") must equal this run's to_double
# digest; other formats are reported and not compared.
separate_arguments(args UNIX_COMMAND "${ARGS}")
execute_process(COMMAND ${EXE} ${args} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "mode_digest failed (${rc})")
endif()
file(READ ${GOLDEN} golden)
function(parse text prefix)
    string(REPLACE "\n" ";" lines "${text}")
    set(keys "")
    foreach(l IN LISTS lines)
        if(l MATCHES "^([^ ]+) +([0-9a-f]+)$")
            set(${prefix}_${CMAKE_MATCH_1} ${CMAKE_MATCH_2} PARENT_SCOPE)
            list(APPEND keys ${CMAKE_MATCH_1})
        endif()
    endforeach()
    set(${prefix}_keys ${keys} PARENT_SCOPE)
endfunction()
parse("${golden}" G)
parse("${out}" O)
set(bad 0)
set(n 0)
foreach(k IN LISTS G_keys)
    if(k STREQUAL "to_long_double")
        if(DEFINED O_to_long_double)
            set(kk to_long_double)
        elseif(DEFINED O_to_long_double_b64)
            if(NOT O_to_long_double_b64 STREQUAL O_to_double)
                message("DIFF to_long_double (binary64): ${O_to_long_double_b64} != to_double ${O_to_double}")
                math(EXPR bad "${bad} + 1")
            else()
                math(EXPR n "${n} + 1")
                message("to_long_double: binary64 long double, equal to to_double")
            endif()
            continue()
        else()
            message("to_long_double: long double format not compared (${O_keys})")
            continue()
        endif()
    endif()
    if(NOT DEFINED O_${k})
        message("MISSING ${k}")
        math(EXPR bad "${bad} + 1")
    elseif(NOT O_${k} STREQUAL G_${k})
        message("DIFF ${k}: ${O_${k}} (golden ${G_${k}})")
        math(EXPR bad "${bad} + 1")
    else()
        math(EXPR n "${n} + 1")
    endif()
endforeach()
list(LENGTH G_keys ng)
if(bad GREATER 0)
    message(FATAL_ERROR "default path differs from the golden digests: ${bad} of ${ng} keys")
endif()
message(STATUS "golden digests identical: ${n} of ${ng} keys")
